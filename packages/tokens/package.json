{
  "name": "@andrescardenasintegrity/integrity-tokens",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "description": "Tokens de diseño agnósticos de framework para Integrity UI/UX (CSS variables, Tailwind preset y marca).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndresCardenasIntegrity/integrity-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/AndresCardenasIntegrity/integrity-ui#readme",
  "bugs": {
    "url": "https://github.com/AndresCardenasIntegrity/integrity-ui/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./tokens.cjs"
    },
    "./css": "./css/theme.css",
    "./preset": {
      "import": "./tailwind.preset.js",
      "require": "./tailwind.preset.cjs"
    },
    "./brand/integrity-mark.svg": "./brand/integrity-mark.svg"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "tokens.cjs",
    "tailwind.preset.js",
    "tailwind.preset.cjs",
    "css/",
    "brand/"
  ]
}
